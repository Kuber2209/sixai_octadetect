# Copy to .env and adjust. Everything runs on the in-premise wired LAN.

# Production:
# DATABASE_URL=postgresql+psycopg2://rfid:CHANGE_ME@localhost:5432/rfid_inventory
# Development (default if unset): SQLite file next to the project.

SECRET_KEY=generate-a-long-random-string-here

# Reader: "mercury" = real ThingMagic M6E, "simulator" = no hardware, "off" = portal only
READER_MODE=simulator
READER_URI=tmr:///dev/ttyUSB0
READER_REGION=open
READER_ANTENNAS=1,2
READER_POWER_CDBM=2700

# Option B checkout detection tuning
ABSENCE_TIMEOUT_S=30
ATTRIBUTION_WINDOW_S=20
SESSION_WINDOW_S=30
